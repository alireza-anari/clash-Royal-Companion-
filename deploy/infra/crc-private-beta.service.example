# REVIEW-ONLY TEMPLATE — do not enable without owner-approved private infrastructure.
# Install into /etc/systemd/system/ only after reviewing paths, ownership,
# the signed package build, operator secrets, Tunnel/VPC and egress controls.
# The backend listener is deliberately localhost-only.
[Unit]
Description=CRC Private Beta Backend (not enabled by default)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/crc-beta/app.env

[Service]
Type=exec
User=crc-beta
Group=crc-beta
WorkingDirectory=/opt/crc-beta/current/api
EnvironmentFile=/etc/crc-beta/app.env
ExecStart=/opt/crc-beta/venv/bin/python -m uvicorn crc_api.beta_gateway:create_beta_app --factory --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# IMPORTANT: this service has outbound network access for Supercell,
# Access JWKS and private Postgres. Firewall/policy must deny inbound access
# to 8000, and the cloudflared connector must target localhost specifically.
# A production operator must run the service and validate real TLS and quotas.

[Install]
WantedBy=multi-user.target
