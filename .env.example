# Copy to api/.env when testing locally; NEVER commit actual secrets.
SUPERCELL_API_KEY=replace-with-your-secret-key
# Only local addresses by default. Do not expose this backend publicly.
# Explicitly reject staging/remote/production mode until protected backend architecture exists.
CRC_RUNTIME_MODE=local
CRC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# UI discovery flag; this is NOT access control. Leave false until security gates pass.
CRC_LIVE_LOOKUP_ENABLED=false

# LOCAL development controls: one Python process only (NOT public security).
CRC_LOCAL_RPM=60
# Optional local-only extra gate. Set a random private secret on the server if needed;
# requests must include X-CRC-Internal-Token. Never expose it in frontend JS.
CRC_INTERNAL_ACCESS_TOKEN=
# Conservative defaults chosen for local testing, NOT official Supercell quotas.
CRC_UPSTREAM_RPM=90
CRC_CACHE_CARDS_TTL=900
CRC_CACHE_PLAYER_TTL=30
CRC_CACHE_BATTLES_TTL=15
CRC_CACHE_MAX_ENTRIES=256

# Private beta AI coach — disabled by default, never enabled by this file.
# OpenRouter key stays encrypted in AWS Systems Manager Parameter Store:
# /crc/mvp/openrouter/api-key (SecureString in eu-north-1).
# The backend fetches it into memory ONLY when explicitly activated.
# Do NOT set OPENROUTER_API_KEY in env files, GitHub, or Cloudflare.
CRC_BETA_AI_ENABLED=false
CRC_OPENROUTER_SSM_PARAMETER=/crc/mvp/openrouter/api-key
